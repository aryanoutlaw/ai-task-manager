# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# Load 10 demo tasks (dates relative to today) on startup
SEED_DATA=true

# ─── LLM (Anthropic Claude) ───────────────────────────────────────────────────
# Get a key at https://console.anthropic.com. Without it, the dashboard works and the assistant
# replies with a clear "not configured" message (HTTP 503).
ANTHROPIC_API_KEY=
# Cheapest current model by default; swap to claude-sonnet-5-5 / claude-opus-5-5 for more capability.
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking effort: low keeps latency and cost down for this routing/tool-calling workload.
LLM_EFFORT=low
LLM_MAX_TOKENS=2048
# Per-LLM-call timeout, retries (LLM calls only — writes are never retried) and total request budget
LLM_TIMEOUT_MS=12000
LLM_MAX_RETRIES=1
ASSISTANT_DEADLINE_MS=30000
ASSISTANT_MAX_STEPS=6
ASSISTANT_RATE_LIMIT_PER_MIN=30
# Circuit breaker: open after N consecutive availability failures, fail fast for the cool-down
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=30000

# ─── Retrieval ────────────────────────────────────────────────────────────────
# Cosine-similarity threshold, chosen with `npm run kb:calibrate` (see README → Relevance threshold)
KB_RELEVANCE_THRESHOLD=0.18
# Also drop passages scoring below this fraction of the best passage's score
KB_RELATIVE_CUTOFF=0.5
KB_TOP_K=3

# ─── Reliability / testing ────────────────────────────────────────────────────
# Simulate an outage of every task tool (test case 6). In non-production you can also send the
# header `X-Simulate-Tool-Failure: true` per request instead of restarting.
FORCE_TOOL_FAILURE=false
IDEMPOTENCY_TTL_MS=86400000
PENDING_ACTION_TTL_MS=300000
